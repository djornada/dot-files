# pnpm end

# fnm
FNM_PATH="/home/djornada/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="/home/djornada/.local/share/fnm:$PATH"
  eval "`fnm env`"
fi
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
