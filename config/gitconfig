[includeIf "gitdir:~/work/"]
  path = ~/.gitconfig-work
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/opt/1Password/op-ssh-sign"
[push]
  default = matching
[core]
  editor = nvim
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  excludesfile = ~/.gitignore_global
[diff]
  tool = nvim -d
[difftool]
  prompt = false
[pager]
  branch = false
[pull]
  rebase = true
[init]
  defaultBranch = main
[commit]
  gpgsign = true
  rebase = true
